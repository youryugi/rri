  <identificationInfo>
    <MD_DataIdentification>
      <citation>
        <title>Global Map Land cover layer- Global Land Cover by National Mapping Organizations (GLCNMO)</title>
        <date>
          <date>2013-07-19</date>
          <dateType>002</dateType>
        </date>
        <edition>Version 2.0</edition>
      </citation>
      <abstract>GLCNMO represents land cover types. The data shows a representative land cover type of the unit area of ground surface.</abstract>
      
